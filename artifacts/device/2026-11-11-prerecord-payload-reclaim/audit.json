  "dependency": {
    "path": "scripts/prerecord-fifo-lifecycle.py",
    "sha256": "18d617e70051f649267ab37f2d1ceafc7e5d2446ac60529d07315d0e86001906"
  },
  "sequence": [
    "BitsMgr Obtain updates produced byte count, conditionally invalidates cache, records event, unlocks, calls single callback event 0x1f",
    "Video FrameDesc callback calls WriteEntry; enabled RemoveOnWrite can advance base read while virtual read remains held",
    "WriteEntry queues 0x10000000 retirement count before 0x4000002 data-ready message",
    "FIFO worker retirement message calls base callback event 0x4000000 under base write mutex",
    "VideoEnc_BitstreamFifoHandler calls BitsMgr_ConsumeBitstream(stream,bank,count)",
    "BitsMgr marks stream entries 0xfee1dead; retires only contiguous prefix; increments retired bytes by aligned64 length excluding EOS; clears metadata payload pointer"
  ],
  "candidate_backend_interface": {
    "status": "offline_design_only_not_bound_or_device_ready",
    "hook": "single BitsMgr stream callback wrapper, before chaining existing video FrameDesc callback",
    "method": "copy_ready_video_event(event, cpu_ring_bounds, owned_nonblocking_sink)",
    "preconditions": [
      "safe callback installation before producer start with original callback retained",
      "known CPU ring bounds and stock cache invalidation decision",
      "preallocated bounded owner storage",
      "measured hardware copy deadline and DMA/cache stability"
    ],
    "operation_order": [
      "copy transient event metadata",
      "exclude EOS",
      "validate address/length and wrap",
      "copy payload into owned storage",
      "publish owned frame",
      "chain original callback exactly once on every path"
    ],
    "constraints": [
      "do not block encoder callback on SD/network I/O",
      "do not advance base cursor, call BitsMgr Consume or free encoder addresses",
      "overflow records a gap/fails pre-record explicitly while stock path continues",
      "one-minute retention belongs to owned spool storage after immediate copy"
    ],
    "blockers": [
      "stock Register cannot add a second observer when slot is already occupied",
      "no hardware proof that callback entry grants stable payload lifetime for whole copy",
      "payload ring size and worst-case transfer budget unmeasured",
      "audio equivalent copy/retire path and A/V epoch still unproven"
    ]
  },
  "conclusions": {
    "held_virtual_descriptor_is_not_payload_lease": true,
    "video_remove_on_write_bypasses_virtual_remove_messages": true,
    "real_fifo_worker_to_bitsmgr_retirement_chain_executed_offline": true,
    "one_minute_descriptor_only_history_rejected": true,
    "owned_payload_copy_before_retirement_required": true,
    "actual_dsp_overwrite_or_copy_deadline_proven": false,
    "camera_pre_record_implemented": false
  },
  "limitations": [
    "All initial FIFO/metadata/global states and queue messages are synthetic; actual camera configuration and scheduler are not observed.",
    "The bounded task starts after queue receive and stops before next receive; lock, message, diagnostic and allocation functions are explicit fixture models.",
    "Retired byte accounting and metadata invalidation do not prove when hardware overwrites payload; the fixture intentionally preserves payload bytes.",
    "Real BitsMgr Obtain/cache invalidation and DSP hardware are statically traced, not executed here.",
    "No Android/roadmap changes, camera connections, device writes, hidden setters or firmware execution."
  ],
  "safety": {
    "camera_connected": false,
    "device_written": false,
    "hardware_executed": false
  }
