[{"sha":"acbfab16781fb50a91924c28843b7e8cd0dd6cea","filename":"4k+/usb_ether_gadget/Readme.md","status":"added","additions":2,"deletions":0,"changes":2,"blob_url":"https://github.com/irungentoo/Xiaomi_Yi_4k_Camera/blob/2d1236d46ab60531c36fb172555102a6efc8b5a2/4k%2B%2Fusb_ether_gadget%2FReadme.md","raw_url":"https://github.com/irungentoo/Xiaomi_Yi_4k_Camera/raw/2d1236d46ab60531c36fb172555102a6efc8b5a2/4k%2B%2Fusb_ether_gadget%2FReadme.md","contents_url":"https://api.github.com/repos/irungentoo/Xiaomi_Yi_4k_Camera/contents/4k%2B%2Fusb_ether_gadget%2FReadme.md?ref=2d1236d46ab60531c36fb172555102a6efc8b5a2","patch":"@@ -0,0 +1,2 @@\n+# Enable usb ethernet gadget\n+By default the RTOS keeps the usb port to itself, but by using the `CustomPref.linux_usb_serial` preference this can be disabled. To write that preference copy the `system.pref.upload` file to the sd card. This open also loads the `g_serial` kernel module, to instaed load the `g_ether` kernel module and setup the `usb0` interface copy the `autoexec.ash` and the `usb_ether_gadget.sh` to the sd card as well."},{"sha":"869200deea844141c9a18603dbdbabeafd9039e8","filename":"4k+/usb_ether_gadget/autoexec.ash","status":"added","additions":3,"deletions":0,"changes":3,"blob_url":"https://github.com/irungentoo/Xiaomi_Yi_4k_Camera/blob/2d1236d46ab60531c36fb172555102a6efc8b5a2/4k%2B%2Fusb_ether_gadget%2Fautoexec.ash","raw_url":"https://github.com/irungentoo/Xiaomi_Yi_4k_Camera/raw/2d1236d46ab60531c36fb172555102a6efc8b5a2/4k%2B%2Fusb_ether_gadget%2Fautoexec.ash","contents_url":"https://api.github.com/repos/irungentoo/Xiaomi_Yi_4k_Camera/contents/4k%2B%2Fusb_ether_gadget%2Fautoexec.ash?ref=2d1236d46ab60531c36fb172555102a6efc8b5a2","patch":"@@ -0,0 +1,3 @@\n+sleep 10000\n+t ipc rpc clnt exec2 '/tmp/fuse_d/usb_ether_gadget.sh'\n+"},{"sha":"cda11ed290f3937d7f7a53e0b1961db49d0a9b66","filename":"4k+/usb_ether_gadget/system.pref.upload","status":"added","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/irungentoo/Xiaomi_Yi_4k_Camera/blob/2d1236d46ab60531c36fb172555102a6efc8b5a2/4k%2B%2Fusb_ether_gadget%2Fsystem.pref.upload","raw_url":"https://github.com/irungentoo/Xiaomi_Yi_4k_Camera/raw/2d1236d46ab60531c36fb172555102a6efc8b5a2/4k%2B%2Fusb_ether_gadget%2Fsystem.pref.upload","contents_url":"https://api.github.com/repos/irungentoo/Xiaomi_Yi_4k_Camera/contents/4k%2B%2Fusb_ether_gadget%2Fsystem.pref.upload?ref=2d1236d46ab60531c36fb172555102a6efc8b5a2","patch":"@@ -0,0 +1 @@\n+CustomPref.linux_usb_serial=0x01"},{"sha":"a2d4a72be529786cbac19dcf0c89d2a9f357adeb","filename":"4k+/usb_ether_gadget/usb_ether_gadget.sh","status":"added","additions":15,"deletions":0,"changes":15,"blob_url":"https://github.com/irungentoo/Xiaomi_Yi_4k_Camera/blob/2d1236d46ab60531c36fb172555102a6efc8b5a2/4k%2B%2Fusb_ether_gadget%2Fusb_ether_gadget.sh","raw_url":"https://github.com/irungentoo/Xiaomi_Yi_4k_Camera/raw/2d1236d46ab60531c36fb172555102a6efc8b5a2/4k%2B%2Fusb_ether_gadget%2Fusb_ether_gadget.sh","contents_url":"https://api.github.com/repos/irungentoo/Xiaomi_Yi_4k_Camera/contents/4k%2B%2Fusb_ether_gadget%2Fusb_ether_gadget.sh?ref=2d1236d46ab60531c36fb172555102a6efc8b5a2","patch":"@@ -0,0 +1,15 @@\n+#!/bin/sh\n+killall getty\n+rmmod -f g_serial &\n+modprobe ambarella_udc\n+modprobe g_ether dev_addr=12:34:56:78:9a:bc host_addr=12:34:56:78:9a:bd\n+\n+killall dnsmasq\n+ifconfig usb0 192.168.43.1 netmask 255.255.255.0\n+dnsmasq --interface=wlan0 --except-interface=lo --bind-interfaces --nodns -5 -K -R -n --dhcp-range=192.168.42.2,192.168.42.200,infinite\n+dnsmasq --interface=usb0 --except-interface=lo --bind-interfaces --nodns -5 -K -R -n --dhcp-range=192.168.43.2,192.168.43.200,infinite\n+\n+#sleep 2\n+#echo host > /proc/ambarella/usbphy0\n+#sleep 1\n+#echo device > /proc/ambarella/usbphy0"},{"sha":"48cb5f3b345bee8f79a8cc21e2d9e83d23d564ed","filename":"4k+/usb_serial_gadget/Readme.md","status":"added","additions":2,"deletions":0,"changes":2,"blob_url":"https://github.com/irungentoo/Xiaomi_Yi_4k_Camera/blob/2d1236d46ab60531c36fb172555102a6efc8b5a2/4k%2B%2Fusb_serial_gadget%2FReadme.md","raw_url":"https://github.com/irungentoo/Xiaomi_Yi_4k_Camera/raw/2d1236d46ab60531c36fb172555102a6efc8b5a2/4k%2B%2Fusb_serial_gadget%2FReadme.md","contents_url":"https://api.github.com/repos/irungentoo/Xiaomi_Yi_4k_Camera/contents/4k%2B%2Fusb_serial_gadget%2FReadme.md?ref=2d1236d46ab60531c36fb172555102a6efc8b5a2","patch":"@@ -0,0 +1,2 @@\n+# Enable usb serial mode\n+By default the RTOS keeps the usb port to itself, but by using the `CustomPref.linux_usb_serial` preference this can be disabled. To write that preference copy the `system.pref.upload` file to the sd card."},{"sha":"cda11ed290f3937d7f7a53e0b1961db49d0a9b66","filename":"4k+/usb_serial_gadget/system.pref.upload","status":"added","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/irungentoo/Xiaomi_Yi_4k_Camera/blob/2d1236d46ab60531c36fb172555102a6efc8b5a2/4k%2B%2Fusb_serial_gadget%2Fsystem.pref.upload","raw_url":"https://github.com/irungentoo/Xiaomi_Yi_4k_Camera/raw/2d1236d46ab60531c36fb172555102a6efc8b5a2/4k%2B%2Fusb_serial_gadget%2Fsystem.pref.upload","contents_url":"https://api.github.com/repos/irungentoo/Xiaomi_Yi_4k_Camera/contents/4k%2B%2Fusb_serial_gadget%2Fsystem.pref.upload?ref=2d1236d46ab60531c36fb172555102a6efc8b5a2","patch":"@@ -0,0 +1 @@\n+CustomPref.linux_usb_serial=0x01"}]