  {
    "offset": "0xd8d",
    "text": "49F0F"
  },
  {
    "offset": "0xdd0",
    "text": "usage: %s <event type> [further info]"
  },
  {
    "offset": "0xdf6",
    "text": "<event type>:"
  },
  {
    "offset": "0xe04",
    "text": "   \"boot_done\": Linux boot done."
  },
  {
    "offset": "0xe25",
    "text": "   \"net_ready\" <type> <: network ready as specified type."
  },
  {
    "offset": "0xe5f",
    "text": "       <type>:"
  },
  {
    "offset": "0xe6e",
    "text": "           0: AP mode."
  },
  {
    "offset": "0xe85",
    "text": "           1: STA mode."
  },
  {
    "offset": "0xe9d",
    "text": "           2: P2P mode."
  },
  {
    "offset": "0xeb5",
    "text": "   \"net_off\": network turned-off."
  },
  {
    "offset": "0xed7",
    "text": "   \"module\": Wi-Fi module information."
  },
  {
    "offset": "0xefe",
    "text": "   \"photo\": Capture photo with bluetooth shutter."
  },
  {
    "offset": "0xf30",
    "text": "   \"record\": Record with bluetooth shutter."
  },
  {
    "offset": "0xf5c",
    "text": "   \"iperf\": 1: iperf ok 0: iperf error."
  },
  {
    "offset": "0xf84",
    "text": "   \"btinfo\": 1: btinfo ok 0: btinfo error."
  },
  {
    "offset": "0xfaf",
    "text": "   \"rtmp\": 0: rtmp start 1:zbar ok 2:zbar error 3:configue file is not creat. 4"
  },
  {
    "offset": "0x1001",
    "text": "ipaddr get okay 5"
  },
  {
    "offset": "0x1015",
    "text": "connect ap fail 6:wan gate okay 7:wan gate fail"
  },
  {
